# Bonvera Studio — environment template
# Copy to `.env.local` for local development. Never commit secrets.

# -----------------------------------------------------------------------------
# App — dual-domain
# -----------------------------------------------------------------------------
# Production:
#   NEXT_PUBLIC_MARKETING_URL=https://bonvera.food
#   NEXT_PUBLIC_ADMIN_URL=https://admin.bonvera.food
# Local (defaults if omitted in development):
#   marketing → http://localhost:3000
#   admin     → http://admin.localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000

# Deprecated alias for marketing URL (optional). Prefer NEXT_PUBLIC_MARKETING_URL.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development

# App routing locales (Studio Admin UI = Turkish).
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_FALLBACK_LOCALE=tr

# -----------------------------------------------------------------------------
# Supabase (Auth, Storage, Realtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Database (Supabase Postgres — used by Drizzle)
# Prefer the connection pooler URL for serverless / Next.js.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# AI (Ask Bonvera / future agents — optional until those modules land)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
