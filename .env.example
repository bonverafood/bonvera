# Studio OS — environment template
# Copy to `.env.local` for local development. Never commit secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# App routing locales (Studio Admin UI = Turkish).
# Public marketing may still publish FR via Translation Engine later;
# that does not change these defaults.
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_FALLBACK_LOCALE=tr

# -----------------------------------------------------------------------------
# Supabase (Auth, Storage, Realtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Database (Supabase Postgres — used by Drizzle)
# Prefer the connection pooler URL for serverless / Next.js.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# AI (Ask Bonvera / future agents — optional until those modules land)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
